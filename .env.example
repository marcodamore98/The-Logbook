# Facoltativo: di solito basta compilare src/lib/config.ts.
# Copia in .env.local e compila. Senza configurazione Firebase l'app funziona
# in modalità locale (dati solo sul dispositivo).

# Firebase (Console Firebase → Impostazioni progetto → App web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Google Calendar (Google Cloud Console → Credenziali → ID client OAuth 2.0, tipo "Applicazione web")
VITE_GOOGLE_CLIENT_ID=
